{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Only what the shell actually needs: spawn the bundled sidecar, pick a folder.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "dialog:allow-open",
    {
      "identifier": "shell:allow-spawn",
      "allow": [{ "name": "binaries/nkqa-server", "sidecar": true, "args": true }]
    }
  ]
}
