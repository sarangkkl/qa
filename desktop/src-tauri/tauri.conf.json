{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nkqa",
  "version": "0.1.0",
  "identifier": "com.gauravsah.nkqa",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nkqa",
        "width": 1400,
        "height": 900,
        "minWidth": 1000,
        "minHeight": 640,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: http://127.0.0.1:*; media-src 'self' blob: http://127.0.0.1:*; connect-src 'self' http://127.0.0.1:* ws://127.0.0.1:*; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg", "msi"],
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/nkqa-server"],
    "resources": [],
    "copyright": "",
    "category": "DeveloperTool",
    "shortDescription": "AI QA teammate",
    "macOS": {
      "minimumSystemVersion": "10.15",
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {}
}
